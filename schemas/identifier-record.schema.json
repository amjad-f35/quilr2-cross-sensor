{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.ai/identity/identifier-record.schema.json",
  "title": "Quilr Identifier Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier_record_id",
    "tenant_id",
    "canonical_entity_id",
    "entity_kind",
    "namespace",
    "identifier_type",
    "identifier_value",
    "source_id",
    "first_seen",
    "last_seen",
    "assurance",
    "confidence",
    "status"
  ],
  "properties": {
    "identifier_record_id": {
      "type": "string",
      "pattern": "^id-record:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null only for approved global catalog identifiers."
    },
    "canonical_entity_id": {
      "type": "string",
      "pattern": "^entity:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "entity_kind": {
      "type": "string",
      "enum": [
        "Tenant",
        "Organization Unit",
        "Human User",
        "Group",
        "Service Account",
        "Workload Identity",
        "Credential",
        "Session",
        "AI Product",
        "Application Surface",
        "Tenant Application",
        "Application Installation",
        "Tenant Subscription",
        "Application Account",
        "Device",
        "Browser Instance",
        "Endpoint Process",
        "Model Provider",
        "Model Family",
        "Model Version",
        "Model Deployment",
        "Model Route",
        "Agent Definition",
        "Agent Version",
        "Agent Deployment",
        "Agent Runtime",
        "Agent Run",
        "MCP Client",
        "MCP Server Product",
        "MCP Server Deployment",
        "Tool",
        "Tool Version",
        "Connector",
        "Integration Instance",
        "Connected Account",
        "Data Asset",
        "Data Class",
        "Knowledge Base",
        "Vector Index",
        "Memory Store",
        "Prompt Template",
        "Gateway",
        "Sensor",
        "Enforcement Point",
        "Policy",
        "Control",
        "Exception",
        "Approval",
        "Decision",
        "Finding",
        "Evidence Record",
        "Certification",
        "Cost Record",
        "Outcome",
        "Person",
        "Employment Relationship",
        "Directory Account",
        "IdP Account",
        "SaaS User Account",
        "Local Application Account",
        "Privileged Account",
        "Browser Product",
        "Browser Installation",
        "Browser Profile",
        "Browser Extension Installation",
        "Physical Hardware",
        "OS Installation",
        "Managed Device Record",
        "Cloud VM Instance",
        "Current Boot",
        "Workload Deployment",
        "Workload Instance",
        "Agent Configuration",
        "Agent Artifact",
        "Agent Session",
        "Agent Step",
        "Sub-agent",
        "Agent Account",
        "Model Artifact",
        "Model Configuration",
        "Model Fine-tune",
        "Model Adapter",
        "Model Quantized Variant",
        "Serving Endpoint",
        "Model-serving Workload",
        "MCP Server Definition",
        "MCP Server Version",
        "MCP Connection",
        "Connector Product",
        "Connector Version",
        "OAuth Client",
        "OAuth Grant",
        "Synchronization Job",
        "Source Repository",
        "Source Revision",
        "Build Invocation",
        "Build Platform",
        "Software Artifact",
        "Release",
        "Software Deployment",
        "Runtime Instance",
        "Secret Record",
        "Secret Version",
        "Authorization Grant",
        "Token",
        "Cryptographic Key",
        "Certificate",
        "Trust Anchor",
        "Federation",
        "Delegation",
        "Artifact Signature",
        "Attestation",
        "Provenance Record",
        "SBOM",
        "Policy Version",
        "Compiled Policy Bundle",
        "Policy Deployment",
        "Policy Evaluation"
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "identifier_type": {
      "type": "string",
      "minLength": 1
    },
    "identifier_value": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuer_or_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_until": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "assurance": {
      "type": "string",
      "enum": [
        "claimed",
        "observed",
        "correlated",
        "authoritative_source",
        "cryptographically_verified",
        "runtime_attested",
        "hardware_attested"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "superseded",
        "revoked",
        "retired",
        "conflict"
      ]
    },
    "proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proof_type",
            "proof_reference",
            "verification_result"
          ],
          "properties": {
            "proof_type": {
              "type": "string"
            },
            "proof_issuer": {
              "type": [
                "string",
                "null"
              ]
            },
            "proof_reference": {
              "type": "string"
            },
            "verification_result": {
              "type": "string",
              "enum": [
                "verified",
                "failed",
                "unverified",
                "expired",
                "revoked",
                "unresolved"
              ]
            },
            "verified_at": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expires_at": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verifier_identity": {
              "type": [
                "string",
                "null"
              ]
            },
            "trust_policy_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
