{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.ai/identity/provenance-record.schema.json",
  "title": "Quilr Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_id",
    "tenant_id",
    "predicate_type",
    "subjects",
    "builder_identity",
    "build_id",
    "started_at",
    "finished_at",
    "materials",
    "attestation_digest",
    "verification"
  ],
  "properties": {
    "provenance_id": {
      "type": "string",
      "pattern": "^provenance:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement_type": {
      "type": "string",
      "default": "https://in-toto.io/Statement/v1"
    },
    "predicate_type": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha256",
                  "sha512",
                  "git-sha1",
                  "git-sha256",
                  "swhid",
                  "other"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "builder_identity": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "build_platform": {
      "type": "string"
    },
    "build_definition": {
      "type": "string"
    },
    "external_parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "digest"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "sha256",
                  "sha512",
                  "git-sha1",
                  "git-sha256",
                  "swhid",
                  "other"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "attestation_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "git-sha1",
            "git-sha256",
            "swhid",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transparency_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_at",
        "verifier_identity",
        "trust_policy_version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "unverified",
            "expired",
            "revoked"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verifier_identity": {
          "type": "string"
        },
        "trust_policy_version": {
          "type": "string"
        },
        "expected_builder": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_match": {
          "type": "boolean"
        },
        "source_match": {
          "type": "boolean"
        }
      }
    }
  }
}
