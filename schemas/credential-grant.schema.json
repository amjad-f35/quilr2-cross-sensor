{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.ai/identity/credential-grant.schema.json",
  "title": "Quilr Credential Grant and Delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "tenant_id",
    "issuer",
    "subject_id",
    "actor_id",
    "audiences",
    "actions",
    "resources",
    "issued_at",
    "expires_at",
    "status",
    "delegation"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^grant:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^entity:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^entity:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "data_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "purpose": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "spend_limit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "revoked",
        "consumed"
      ]
    },
    "key_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "none",
            "dpop",
            "mtls",
            "workload",
            "other"
          ]
        },
        "jwk_thumbprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "certificate_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method"
      ]
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth",
        "maximum_depth",
        "attenuation_verified"
      ],
      "properties": {
        "delegation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_depth": {
          "type": "integer",
          "minimum": 0
        },
        "attenuation_verified": {
          "type": "boolean"
        },
        "verified_against_parent_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revoked_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "descendants_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "revoked",
            "failed"
          ]
        }
      }
    }
  }
}
