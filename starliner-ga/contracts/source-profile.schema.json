{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quilr:starliner:schema:v1:source-profile",
  "title": "Starliner Source Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "source_family",
    "integration_roles",
    "deployment_forms",
    "record_schemas",
    "identifier_rules",
    "authority_rules",
    "lifecycle",
    "privacy",
    "capabilities",
    "coverage",
    "resource_profile",
    "certification_pack"
  ],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_family": {
      "type": "string",
      "enum": ["browser", "endpoint", "llm_gateway", "mcp_gateway", "enterprise_connector", "legacy"]
    },
    "integration_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["runtime_sensor", "discovery_connector", "telemetry_importer", "control_connector", "response_connector"]
      }
    },
    "deployment_forms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["embedded", "sidecar", "daemon", "managed_connector_worker"]}
    },
    "record_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "schema_id", "required"],
        "properties": {
          "record_type": {"type": "string", "minLength": 1},
          "schema_id": {"type": "string", "format": "uri-reference"},
          "required": {"type": "boolean"}
        }
      }
    },
    "identifier_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_type", "namespace", "scope", "stability", "privacy_class"],
        "properties": {
          "object_type": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "stability": {"enum": ["immutable", "stable", "rotatable", "ephemeral", "weak_alias"]},
          "privacy_class": {"enum": ["structural", "enterprise_identifier", "pseudonymous", "sensitive_metadata"]},
          "normalization": {"type": ["string", "null"]}
        }
      }
    },
    "authority_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_type", "authority", "scope", "freshness"],
        "properties": {
          "claim_type": {"type": "string", "minLength": 1},
          "authority": {"enum": ["authoritative", "direct_observation", "attested", "derived", "user_asserted", "imported_legacy"]},
          "scope": {"type": "string", "minLength": 1},
          "freshness": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "source_revisions", "explicit_delete", "full_reconciliation", "absence_authority", "epoch_reset"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["upsert", "correct", "delete", "tombstone"]}
        },
        "source_revisions": {"type": "boolean"},
        "explicit_delete": {"type": "boolean"},
        "full_reconciliation": {"type": "boolean"},
        "absence_authority": {"type": "boolean"},
        "epoch_reset": {"type": "boolean"},
        "staleness_policy": {"type": "string", "minLength": 1}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_classes", "restricted_content", "prohibited_fields", "pre_wal_filter"],
      "properties": {
        "allowed_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["structural", "enterprise_identifier", "pseudonymous", "sensitive_metadata"]}
        },
        "restricted_content": {"enum": ["unsupported", "separate_grant_only"]},
        "prohibited_fields": {"type": "array", "items": {"type": "string"}},
        "pre_wal_filter": {"const": true}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "class", "mode", "certification_level"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "class": {"enum": ["observe", "decide", "enforce", "effect_observe", "effect_verify", "reconcile"]},
          "mode": {"enum": ["required", "optional"]},
          "certification_level": {
            "enum": ["protocol", "payload_safe", "observe", "decision", "enforcement", "effect_observation", "effect_verification", "operational"]
          },
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_population_source", "health_dimensions", "gap_reporting"],
      "properties": {
        "expected_population_source": {"type": "string", "minLength": 1},
        "health_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["capture", "privacy", "durability", "delivery", "time", "policy", "control", "software"]}
        },
        "gap_reporting": {"const": true}
      }
    },
    "resource_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cpu", "memory", "disk", "network", "latency", "offline"],
      "properties": {
        "status": {"enum": ["NEEDS_INPUT", "measured", "certified"]},
        "cpu": {"type": "string"},
        "memory": {"type": "string"},
        "disk": {"type": "string"},
        "network": {"type": "string"},
        "latency": {"type": "string"},
        "offline": {"type": "string"}
      }
    },
    "certification_pack": {
      "type": "string",
      "minLength": 1
    }
  }
}
