{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.com/starliner/ingest/v1/ingest-receipt.schema.json",
  "title": "Starliner Ingest Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "batch_id", "ingest_request_id", "received_at", "results"],
  "properties": {
    "api_version": { "const": "starliner.ingest.v1" },
    "batch_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ingest_request_id": { "type": "string", "format": "uuid" },
    "received_at": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "record_id", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "record_id": { "type": "string", "format": "uuid" },
          "status": { "enum": ["accepted", "duplicate", "rejected", "retry"] },
          "evidence_id": { "type": "string", "format": "uuid" },
          "producer_epoch": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "error_code": {
            "enum": [
              "schema_invalid",
              "profile_unsupported",
              "privacy_violation",
              "record_not_authorized",
              "producer_uncertified",
              "producer_revoked",
              "tenant_mismatch",
              "sequence_conflict",
              "record_too_large",
              "backpressure",
              "storage_unavailable",
              "internal_error"
            ]
          },
          "error_field": { "type": "string", "maxLength": 256 },
          "retry_after_ms": { "type": "integer", "minimum": 1, "maximum": 300000 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "enum": ["accepted", "duplicate"] } } },
            "then": { "required": ["evidence_id", "producer_epoch", "sequence"] }
          },
          {
            "if": { "properties": { "status": { "enum": ["rejected", "retry"] } } },
            "then": { "required": ["error_code"] }
          },
          {
            "if": { "properties": { "status": { "const": "retry" } } },
            "then": { "required": ["retry_after_ms"] }
          }
        ]
      }
    }
  }
}
