{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.example/die/normalization-bundle.schema.json",
  "title": "DIE normalization bundle manifest v1",
  "description": "Atomic manifest for every normalized output produced from one evidence record. output_count equality, unique output keys and digest recomputation are mandatory transaction checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalization_run_id",
    "tenant_id",
    "evidence_id",
    "producer_id",
    "source_profile",
    "profile_version",
    "normalizer",
    "output_count",
    "output_refs",
    "bundle_digest",
    "normalized_at"
  ],
  "properties": {
    "normalization_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "description": "Exact registered source profile used to admit and normalize the evidence."
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 128
    },
    "normalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "output_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "output_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_key", "observation_id", "output_digest"],
        "properties": {
          "output_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "observation_id": {
            "type": "string",
            "format": "uuid"
          },
          "output_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "normalized_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
