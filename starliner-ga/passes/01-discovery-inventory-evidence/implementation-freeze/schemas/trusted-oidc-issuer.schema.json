{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.ai/die/trusted-oidc-issuer/1.0.0",
  "title": "Trusted OIDC Issuer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "issuer_uri", "discovery_uri",
    "allowed_audiences", "allowed_algorithms", "jwks_soft_ttl_seconds",
    "jwks_hard_ttl_seconds", "forced_refresh_min_interval_seconds",
    "max_token_lifetime_seconds", "clock_skew_seconds", "state", "revision"
  ],
  "properties": {
    "schema_version": {"const": "die.trusted-oidc-issuer.v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "issuer_uri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "discovery_uri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "allowed_audiences": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "allowed_algorithms": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["RS256", "PS256", "ES256", "EdDSA"]}
    },
    "jwks_soft_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900},
    "jwks_hard_ttl_seconds": {"type": "integer", "minimum": 3600, "maximum": 86400},
    "forced_refresh_min_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 300},
    "max_token_lifetime_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "state": {"enum": ["pending", "active", "disabled", "revoked"]},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
