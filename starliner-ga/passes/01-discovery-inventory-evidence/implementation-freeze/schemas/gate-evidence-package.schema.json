{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quilr:die:schema:gate-evidence-package:1.0.0",
  "title": "DIE gate evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "gate_id",
    "test_id",
    "result",
    "started_at",
    "finished_at",
    "candidate",
    "environment",
    "commands",
    "assertions",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "die-gate-evidence/1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "gate_id": {
      "type": "string",
      "enum": [
        "LG-001",
        "LG-002",
        "LG-003",
        "LG-004",
        "LG-005",
        "LG-006",
        "LG-007"
      ]
    },
    "test_id": {
      "type": "string",
      "pattern": "^LG00[1-7]-T[0-9]{3}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_commit",
        "repository_tree",
        "contract_digest",
        "artifact_digests"
      ],
      "properties": {
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "kind",
        "os",
        "architecture",
        "component_versions",
        "configuration_digest"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "clean_room",
            "local_smoke",
            "integration",
            "stress",
            "release_qualification"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "component_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "configuration_digest": {
          "$ref": "#/$defs/digest"
        },
        "fixture_digest": {
          "$ref": "#/$defs/digest"
        },
        "fault_schedule_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "exit_code"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "result",
          "message"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "relative_path",
          "sha256",
          "contains_customer_data"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "log",
              "trace",
              "query_plan",
              "catalog_snapshot",
              "configuration",
              "fixture",
              "report",
              "screenshot",
              "receipt",
              "manifest",
              "binary"
            ]
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$",
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "contains_customer_data": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "disposition",
        "reviewed_at"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disposition": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "REJECT"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
