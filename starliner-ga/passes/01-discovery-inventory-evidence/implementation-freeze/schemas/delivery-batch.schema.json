{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quilr.com/starliner/ingest/v1/delivery-batch.schema.json",
  "title": "Starliner Delivery Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "batch_id", "records"],
  "properties": {
    "api_version": { "const": "starliner.ingest.v1" },
    "batch_id": { "$ref": "#/$defs/opaqueId" },
    "compression": { "enum": ["identity", "gzip", "zstd"], "default": "identity" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "namespace", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 96 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
        "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "parent": { "$ref": "#/$defs/sourceObjectIdentity" }
      }
    },
    "sourceObjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "namespace", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 96 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
        "id": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "digest"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": { "type": "string", "maxLength": 256 },
        "commit": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "capture_state"],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capture_state": {
          "enum": ["complete", "minimized", "redacted", "metadata_only", "unsupported"]
        },
        "removed_categories": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 96 }
        },
        "pseudonymization_key_version": { "type": "string", "maxLength": 128 }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": { "$ref": "#/$defs/opaqueId" },
        "request_id": { "type": "string", "maxLength": 512 },
        "session_id": { "type": "string", "maxLength": 512 },
        "correlation_id": { "type": "string", "maxLength": 512 },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "parent_record_id": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "tenant_id",
        "producer_id",
        "installation_id",
        "runtime_instance_id",
        "producer_epoch",
        "sequence",
        "record_id",
        "record_type",
        "profile",
        "profile_version",
        "schema_ref",
        "occurred_at",
        "observed_at",
        "enqueued_at",
        "source_object",
        "artifact",
        "certification_id",
        "record_origin",
        "evidence_quality",
        "privacy",
        "idempotency_key",
        "content_sha256"
      ],
      "properties": {
        "protocol": { "const": "starliner.edge.v1" },
        "tenant_id": { "$ref": "#/$defs/opaqueId" },
        "producer_id": { "$ref": "#/$defs/uuid" },
        "installation_id": { "$ref": "#/$defs/opaqueId" },
        "runtime_instance_id": { "$ref": "#/$defs/opaqueId" },
        "producer_epoch": { "type": "string", "format": "uuid" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unsigned JavaScript-safe sequence within producer_epoch. The epoch must rotate before this bound."
        },
        "record_id": { "$ref": "#/$defs/uuid" },
        "record_type": {
          "enum": [
            "object.observed",
            "object.changed",
            "object.tombstoned",
            "relationship.observed",
            "relationship.ended",
            "activity.observed",
            "decision.observed",
            "outcome.observed",
            "reconciliation.observed",
            "coverage.observed",
            "gap.observed",
            "health.observed"
          ]
        },
        "profile": {
          "enum": ["browser", "browser_backend", "endpoint", "llm_gateway", "mcp_gateway"]
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "schema_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "enqueued_at": { "$ref": "#/$defs/timestamp" },
        "source_object": { "$ref": "#/$defs/sourceObjectRef" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "certification_id": { "$ref": "#/$defs/uuid" },
        "record_origin": {
          "enum": ["live_sensor", "selftest", "synthetic", "fixture", "legacy_backfill", "manual_import"]
        },
        "evidence_quality": {
          "enum": ["audit_grade", "operational", "best_effort", "debug_only", "fixture"]
        },
        "privacy": { "$ref": "#/$defs/privacy" },
        "correlation": { "$ref": "#/$defs/correlation" },
        "idempotency_key": { "$ref": "#/$defs/opaqueId" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "extensions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(?:\\.[a-z0-9_-]+)+$" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "maxLength": 512 },
              { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              { "type": "boolean" },
              { "type": "null" }
            ]
          },
          "maxProperties": 32
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "payload"],
      "properties": {
        "envelope": { "$ref": "#/$defs/envelope" },
        "payload": { "type": "object" }
      }
    }
  }
}
